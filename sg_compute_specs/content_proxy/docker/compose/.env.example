# ═══════════════════════════════════════════════════════════════════════════════
# Content-Transformation Proxy — local .env (copy to .env; NEVER commit the real one)
# ═══════════════════════════════════════════════════════════════════════════════

# MITM service API key (the interceptor ↔ mitm-service). BOTH must be set.
# FASTAPI_API_KEY_VALUE must be a GUID — the mitm-service rejects a non-GUID key.
# Left as the `change-me` placeholder, `sg content-proxy local up` auto-generates a GUID.
FASTAPI_API_KEY_NAME=x-api-key
FASTAPI_API_KEY_VALUE=change-me

# mitmproxy-ext basic-auth creds (Mode 1 — the human browser's proxy credentials)
CONTENT_PROXY__PROXYAUTH_USER=demo
CONTENT_PROXY__PROXYAUTH_PASS=change-me

# ── the access token (ONE value in TWO vars — they MUST be identical) ────────────
# FAST_API__AUTH__API_KEY__VALUE : the vault's API key AND sg-playwright's API key.
# SGRAPH_SEND__ACCESS_TOKEN      : the vault send-token + what the /pw front door
#                                  (vault serve_with_proxy, or the Caddy edge)
#                                  forwards to sg-playwright as X-API-Key.
# If these two differ, / says "Client API key missing" and /pw says "Invalid API
# key value". `local up` auto-generates ONE GUID into BOTH when left as change-me.
# This is the token you paste into https://localhost/auth/set-cookie-form.
FAST_API__AUTH__API_KEY__NAME=x-api-key
FAST_API__AUTH__API_KEY__VALUE=change-me
SGRAPH_SEND__ACCESS_TOKEN=change-me

# directory holding the user-supplied proxy CA (mitmproxy-ca.pem etc.); default ./certs
CONTENT_PROXY__CA_DIR=./certs

# vault-app storage mode (memory for local MVP; s3 for fleet logging post-MVP)
SEND__STORAGE_MODE=memory

# --tls letsencrypt (IP cert via ACME). Prod is the default (LE issues IP certs
# only in production); email is optional but recommended. Same as sg va.
SG__CERT_INIT__ACME_EMAIL=
# SG__CERT_INIT__ACME_PROD=true

# AWS creds for cp-mitm-service to read the scripts S3 bucket (LOCAL ONLY — never commit real keys).
# On EC2/prod leave these blank and use the instance role instead.
AWS_ACCOUNT_ID=
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket the MITM service reads the injection scripts from
CACHE__SERVICE__BUCKET_NAME=
